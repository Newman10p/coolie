# Supabase project: dgyhahgtocogfwljwioc (us-east-1)
# Public project URL may be used by the frontend for Supabase Auth only.
# Never place service-role keys or database passwords in VITE_* variables.
SUPABASE_URL=https://dgyhahgtocogfwljwioc.supabase.co
SUPABASE_REGION=us-east-1
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_DB_PASSWORD=your_database_password
COOLIE_WORKSPACE_ID=
# Optional deployment-owned service factory for `python -m ui.live_server`.
# COOLIE_SERVICES_FACTORY=your_module:create_coolie_services

# Optional server-only override. If omitted, Coolie uses Supabase's regional
# session pooler (aws-0-us-east-1.pooler.supabase.com:5432).
# DATABASE_URL=postgresql://postgres.dgyhahgtocogfwljwioc:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Research Room MCP resources (server-side only; never use VITE_ prefixes).
# These are consumed only when the deployment service factory enables the
# ResearchMCPBridge. The OpenSearch cluster and index must already exist.
FIRECRAWL_API_KEY=
OPENSEARCH_URL=
OPENSEARCH_INDEX=
# Optional OpenSearch basic-auth credentials; use AWS environment/role
# credentials for a managed OpenSearch cluster when applicable.
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Browser navigation is restricted to these exact hosts or *.subdomain hosts.
COOLIE_RESEARCH_BROWSER_ALLOWED_HOSTS=
